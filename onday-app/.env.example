# === Supabase Auth (CMD-AUTH-001/003 / W1-2) ===
# supabase-js(@supabase/ssr) 용 공개 키 — DB 의 DATABASE_URL 과 별개.
# Project Settings → API 에서 복사. 둘 다 NEXT_PUBLIC_(클라이언트 노출 OK).
# ★ 최신 Supabase = publishable key(sb_publishable_...). 코드는 PUBLISHABLE 우선,
#   없으면 레거시 ANON 으로 fallback (lib/supabase/keys.ts). 둘 중 하나만 채우면 됨.
# SERVICE_ROLE 은 RLS 우회용 — 본 슬라이스(user-sync=Prisma)엔 불필요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # 레거시 프로젝트면 이걸 사용 (fallback)
SUPABASE_SERVICE_ROLE_KEY=

# Kakao
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_MOBILITY_API_KEY=
# CMD-DIAG-001: 브라우저 직접 호출 (Vercel 10초 timeout 우회) — Kakao Developers Console 도메인 제한 필수
NEXT_PUBLIC_KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# === ODsay 대중교통 (W2 — REAL-API-W2-ODSAY-TRANSIT) ===
# 통근시간 "대중교통" 데이터 소스 (카카오 모빌리티는 자동차 전용 → 자차 별도).
# ★ Web key — 브라우저 직접 호출 (도메인 인증). ODsay 는 CORS 허용(ACAO: *) 이라 브라우저 직접 정상.
#   Vercel 고정 IP 불필요 = Server key + /api/commute 프록시(IP 화이트리스트 막힘) 대체.
#   ★ NEXT_PUBLIC_ 접두사 = 빌드타임 inline (브라우저 노출은 Web 키 설계상 정상). 변경 시 Redeploy.
#   ODsay 콘솔에서 Web 서비스 등록 + 도메인(localhost, *.vercel.app) 허용.
NEXT_PUBLIC_ODSAY_API_KEY=
# (구) Server key — /api/commute 프록시 폐지로 미사용. 레거시 참고용.
# ODSAY_API_KEY=

# === AI (동네 하루 미리보기 — SRS CON-13/14: Vercel AI SDK + Gemini) ===
# 동네별 AI 인사이트 생성(/api/insight). ★ 서버 전용 — NEXT_PUBLIC 아님(키 노출 금지).
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# CON-14 — env 만으로 모델 교체. 미설정 시 비용 효율 gemini-2.0-flash 기본.
# GEMINI_MODEL=gemini-2.0-flash

# App
# NEXT_PUBLIC_USE_MOCK=true → 진단/주소/auth 전부 mock (기본).
NEXT_PUBLIC_USE_MOCK=true
# ★ W1-2 (R1) — auth 도메인만 실 전환하는 토글. 미설정 시 USE_MOCK 로 fallback.
# auth 만 실 카카오 OAuth 로 켜려면 false (진단/주소는 USE_MOCK=true 로 mock 유지).
# NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN: source map upload 용. MON-001에서 실제 값 설정.
SENTRY_AUTH_TOKEN=

# Mixpanel — MON-003 v1.4 부활 (REQ-NF-008 진단 탐색 시간 p50 측정)
# Token 미설정 시 trackDiagnosisStarted/Completed noop (AC-5 가드)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# === Database (INFRA-002 / W1-1 — Supabase Postgres 단일) ===
# 로컬·프로덕션 모두 Supabase Postgres. sqlite 이원화 폐지 (db.ts 가 in-memory 였어
# 로컬 sqlite 는 실서비스 경로가 아니었음). Prisma 7 = 드라이버 어댑터 필수.
#
# DATABASE_URL : 런타임 pooler 연결 (포트 6543) — db.ts 의 PrismaPg 어댑터가 사용
#                ?pgbouncer=true&connection_limit=1 = Vercel 서버리스 + PgBouncer 권장값
#                (DB_SPEC §9.2 — 함수 인스턴스당 커넥션 1개로 풀 고갈 방지)
# DIRECT_URL   : migrate/seed 전용 direct 연결 (포트 5432) — prisma.config.ts / prisma/seed.ts 가 사용
#                (pgBouncer 6543 은 DDL/advisory lock 미지원이라 마이그레이션은 direct 필수)
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
