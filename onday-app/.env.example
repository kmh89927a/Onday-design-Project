# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_MOBILITY_API_KEY=
# CMD-DIAG-001: 브라우저 직접 호출 (Vercel 10초 timeout 우회) — Kakao Developers Console 도메인 제한 필수
NEXT_PUBLIC_KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# AI
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=

# App
# Vercel 배포 시 NEXT_PUBLIC_USE_MOCK=true 만 설정하면 됨
# (DB / Kakao / Supabase 변수는 Step 13 이후 production 모드에서 필요)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN: source map upload 용. MON-001에서 실제 값 설정.
SENTRY_AUTH_TOKEN=

# Database
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
