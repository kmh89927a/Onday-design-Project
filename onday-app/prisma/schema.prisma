generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  authProvider String   @map("auth_provider") // kakao | naver
  mode         String   @default("couple") // couple | single
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  diagnoses   Diagnosis[]
  savedSearch SavedSearch?

  @@map("users")
}

model Diagnosis {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  addressA     String   @map("address_a")
  addressB     String?  @map("address_b") // nullable for single mode
  // 입력 직장 좌표(JSON {lat,lng}). 새로고침 시 경로선 복원용 — 게스트/심사관은 localStorage 미저장이라
  //   서버 GET 만이 복원 경로(프라이버시 유지). nullable — 본 컬럼 이전 진단 row 는 null(기존 동작 유지).
  coordinateA  String?  @map("coordinate_a")
  coordinateB  String?  @map("coordinate_b")
  filters      String   @default("{}") // JSON string — app-layer parse, JSONB는 차후 ISSUE
  candidates   String   @default("[]") // JSON string array of CandidateArea — app-layer parse, JSONB는 차후 ISSUE
  mode         String   @default("couple") // couple | single
  deadlineMode Boolean  @default(false) @map("deadline_mode")
  deadline     DateTime? // nullable, for deadline mode
  status       String   @default("completed") // processing | completed | expired
  createdAt    DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLink ShareLink?

  @@index([userId])
  @@map("diagnoses")
}

model ShareLink {
  id              String   @id @default(uuid())
  diagnosisId     String   @unique @map("diagnosis_id")
  uniqueUrl       String   @unique @map("unique_url") // UUID v4
  passwordHash    String?  @map("password_hash") // bcrypt hash
  viewCount       Int      @default(0) @map("view_count")
  freePreviewUsed Boolean  @default(false) @map("free_preview_used")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model SavedSearch {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  searchParams String   @map("search_params") // JSON string
  savedAt      DateTime @default(now()) @map("saved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

// 3-sink 로깅 DB 채널 (11주차 로깅 — 콘솔+DB+Sentry 중 DB).
// ★ 프라이버시: 개인 식별 필드 없음 — user_id 원문·이메일·이름·정확한 주소 미기록.
//   userType(유형만)·visitorId(익명 localStorage, 개인 신원 무관)·device/os(대분류)만.
//   message 는 호출부에서 maskPII(이메일·전화 [REDACTED]) 거친다. USER 와 FK 없음(귀속 방지).
model ErrorLog {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  level      String // error | warn
  statusCode Int?     @map("status_code")
  route      String? // API route (예: POST /api/diagnosis)
  screenPath String?  @map("screen_path") // 화면 경로 (예: /diagnosis/result/[id])
  errorType  String?  @map("error_type") // AppErrorCode 등 분류
  message    String // maskPII 거친 메시지
  userType   String?  @map("user_type") // kakao | guest | reviewer | null
  visitorId  String?  @map("visitor_id") // 익명 방문자 ID(localStorage, 30일) — 개인 식별 아님
  device     String? // mobile | desktop
  os         String? // ios | android | windows | mac | other
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@map("error_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3단 집계 파이프라인 (금요일 과제 — raw → 가집계 → 최종집계). docs/AGGREGATION_PIPELINE_DESIGN.md
// ★ 전부 신규 CREATE — 기존 5개 테이블 무변경. USER FK 없음·PII 없음(ErrorLog 패턴 답습).
// ★ 본 과제 범위 = 테이블 생성까지. 로그 적재·집계 크론·대시보드는 발표 후(빈 테이블로 생성).
// ─────────────────────────────────────────────────────────────────────────────

// ① 상세로그(raw) — 이벤트 1건 = 1행. 11개 감지 완비 이벤트(AARRR §3-1)를 범용 1테이블로 수용.
model EventLog {
  id          String   @id @default(uuid())
  eventName   String   @map("event_name") // diagnosis_completed 등 11종
  timestamp   DateTime @default(now())
  mode        String? // couple | single
  method      String? // kakao | guest | reviewer (login_entered)
  count       Int? // 1 | 2 (address_verified)
  daysLeft    Int?     @map("days_left") // deadline_mode_activated
  diagnosisId String?  @map("diagnosis_id") // 내부 uuid — FK 미설정(ErrorLog 답습)
  visitorId   String?  @map("visitor_id") // 익명
  props       String? // JSON 오버플로(향후 속성)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([timestamp])
  @@map("event_logs")
}

// ①-preview — 동일 구조 실험/격리용 사본.
model PreviewEventLog {
  id          String   @id @default(uuid())
  eventName   String   @map("event_name")
  timestamp   DateTime @default(now())
  mode        String?
  method      String?
  count       Int?
  daysLeft    Int?     @map("days_left")
  diagnosisId String?  @map("diagnosis_id")
  visitorId   String?  @map("visitor_id")
  props       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([timestamp])
  @@map("preview_event_logs")
}

// ② 가집계(rollup) — 지표유형 × 짧은 주기(1m/10m/1h) 중간 합산. 성능 계층.
model MetricRollup {
  id          String   @id @default(uuid())
  metricType  String   @map("metric_type") // landing_viewed, submit_per_input 등
  bucket      String // 1m | 10m | 1h
  bucketStart DateTime @map("bucket_start")
  value       Float // 집계값
  numerator   Int? // 비율 분자(선택)
  denominator Int? // 비율 분모(선택)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([metricType, bucket, bucketStart])
  @@map("metric_rollups")
}

// ②-preview
model PreviewMetricRollup {
  id          String   @id @default(uuid())
  metricType  String   @map("metric_type")
  bucket      String
  bucketStart DateTime @map("bucket_start")
  value       Float
  numerator   Int?
  denominator Int?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([metricType, bucket, bucketStart])
  @@map("preview_metric_rollups")
}

// ③ 최종집계(aggregate) — H/D/W/M 시각화 단위. 대시보드 전용.
model MetricAggregate {
  id          String   @id @default(uuid())
  metricType  String   @map("metric_type")
  grain       String // H | D | W | M
  periodStart DateTime @map("period_start")
  value       Float
  numerator   Int?
  denominator Int?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([metricType, grain, periodStart])
  @@map("metric_aggregates")
}

// ③-preview
model PreviewMetricAggregate {
  id          String   @id @default(uuid())
  metricType  String   @map("metric_type")
  grain       String
  periodStart DateTime @map("period_start")
  value       Float
  numerator   Int?
  denominator Int?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([metricType, grain, periodStart])
  @@map("preview_metric_aggregates")
}
